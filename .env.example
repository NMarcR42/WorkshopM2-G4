# Copie en .env par scripts/init-local.sh (non versionne). Aucun secret ici : seulement de la configuration.
# Les valeurs par defaut = MODE MONO-HOTE : tout sur une machine, DNS Docker natif, aucune VM requise.

# ============ MODE MONO-HOTE (defaut : dev + secours) ============
ROLES=all                  # toute la plateforme sur cette machine
REMEDIATION_MODE=local     # remediation via docker-proxy (lecture + restart), aucun reseau traverse

PUBLIC_BIND=0.0.0.0        # WAF : joignable depuis le PC attaquant
ADMIN_BIND=127.0.0.1       # Grafana, assistant : local uniquement
OLLAMA_MODEL=qwen2.5:3b
API_PORT=18000           # si le port 8000 de l'hote est deja pris

# ============ MODE MULTI-MACHINES (OPTIONNEL : a activer quand les VM sont pretes) ============
# Sur chaque machine, ne decommenter que son role. Voir doc/ARCHITECTURE.md, "Modes de deploiement".
# ROLES=back                        # front | back | ops | ai (ou plusieurs)
# REMEDIATION_MODE=ssh              # sur la machine ops : Ansible/SSH (cle ansible_ssh_key requise)
# INVENTORY=lab                     # inventaire Ansible (infra/ansible/inventory/)
#
# Adresses privees entre machines (defaut = noms de services Docker, valables en mono-hote) :
# API_URL=http://10.0.0.2:8000      # lu par le WAF
# WAF_URL=http://10.0.0.1:8080      # lu par le canary
# LOKI_URL=http://10.0.0.3:3100     # lu par les agents promtail
# AUTH_URL=http://10.0.0.2:8001     # lu par le WAF (routage /auth)
# WAF_BLOCKLIST_SRC=/opt/resilience/waf-blocklist   # machine front : liste de blocage ecrite par Ansible
#
# Interfaces d'ecoute (a mettre sur l'IP privee de la machine) :
# BACK_BIND=10.0.0.2                # api/auth, filtres au seul WAF
# OPS_BIND=10.0.0.3                 # Loki
# AGENT_BIND=10.0.0.2               # cAdvisor
