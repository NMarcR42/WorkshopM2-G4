# Gateway interne — routage vers les microservices (géré par Ansible)
# La résolution DNS dynamique (resolver + variables) permet de recréer un conteneur
# sans redémarrer le gateway : indispensable pour une remédiation propre.
resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 8080 default_server;
    server_tokens off;
    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $up_api http://api:{{ app_ports.api }};
        proxy_pass $up_api;
    }

    location /auth/ {
        set $up_auth http://auth:{{ app_ports.auth }};
        proxy_pass $up_auth;
    }

    location / {
        set $up_front http://frontend:{{ app_ports.frontend }};
        proxy_pass $up_front;
    }
}
